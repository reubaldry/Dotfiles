# ==========================================
# PHANTOM SPACE INITIALIZATION
# ==========================================
if ! yabai -m query --spaces | jq -e '.[] | select(.label == "scratchpad")' > /dev/null; then
    
    # Grab the absolute last space index on the machine
    LAST_SPACE=$(yabai -m query --spaces | jq '.[-1].index')
    
    # Count how many windows are in that last space
    LAST_SPACE_WINDOWS=$(yabai -m query --spaces --space "$LAST_SPACE" | jq '.windows | length')
    
    if [ "$LAST_SPACE_WINDOWS" -eq 0 ]; then
        # Scenario A: The last space is totally empty. It's our orphaned phantom space.
        yabai -m space "$LAST_SPACE" --label scratchpad
    else
        # Count how many of those windows are specifically our Scratchpad
        ONLY_GHOSTTY=$(yabai -m query --windows --space "$LAST_SPACE" | jq '[.[] | select(.app == "Ghostty" and .title != null and (.title | contains("Scratchpad")))] | length')
        
        if [ "$ONLY_GHOSTTY" -eq "$LAST_SPACE_WINDOWS" ]; then
            # Scenario B: The last space has windows, but it's ONLY the hidden Scratchpad.
            yabai -m space "$LAST_SPACE" --label scratchpad
        else
            # Scenario C: The last space has real, active windows (e.g., your browser).
            # We legitimately need to build a new hidden space.
            yabai -m space --create
            NEW_LAST=$(yabai -m query --spaces | jq '.[-1].index')
            yabai -m space "$NEW_LAST" --label scratchpad
        fi
    fi
fi
