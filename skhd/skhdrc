# ================================================================
#                             MODES
# ================================================================
# Defines different modes for different commands.
# ----------------------------------------------------------------


:: float
:: layout
:: move
:: config

alt + shift - 1 ; move
alt + shift - 2 ; config
alt + shift - 3 ; layout
alt + shift - 4 ; float

move, config, layout, float < escape ; default


# ================================================================
#                             APPS
# ================================================================
# Launch applications directly from default mode using cmd + ctrl.
# Use these bindings to quickly open your favorite apps.
# ----------------------------------------------------------------

# App launchers
cmd + ctrl - t : open -a /Applications/Ghostty.app/Contents/MacOS/ghostty
cmd + shift + ctrl - t : open -n -a /Applications/Ghostty.app/Contents/MacOS/ghostty
cmd + ctrl - f : open -a /Applications/Firefox.app/Contents/MacOS/firefox
cmd + shift + ctrl - f : open -n -a /Applications/Firefox.app/Contents/MacOS/firefox
cmd + ctrl - w : open -a /Applications/WhatsApp.app/Contents/MacOS/WhatsApp
cmd + ctrl - o : open -a /Applications/Obsidian.app/Contents/MacOS/Obsidian
#cmd + ctrl - e : open -n -a Ghostty --args --title=yazi -e /opt/homebrew/bin/yazi
#cmd + ctrl - e : open -n -a Ghostty --args --title=yazi -e /bin/zsh -c "/opt/homebrew/bin/yazi"
cmd + ctrl - e : open -n -a Ghostty --args --config-file=$HOME/.config/ghostty/custom_configs/yazi-launcher

# Special launchers
# ctrl - return : open -n -a Ghostty --args --config-file=$HOME/.config/ghostty/custom_configs/scratchpad
ctrl - return : ~/.config/skhd/scripts/scratchpad.sh
# ctrl - return : ~/.config/skhd/scripts/scratchpad.sh

# Change ghostty opacity
cmd - brightness_up : ~/.config/ghostty/scripts/opacity.sh inc
cmd - brightness_down : ~/.confi/ghostty/scripts/opacity.sh dec
cmd - escape : ~/.config/ghostty/scripts/opacity.sh

# Hide sketchybar
ctrl + cmd - s : /opt/homebrew/bin/sketchybar --bar hidden=toggle

# ================================================================
#                            SPACES
# ================================================================
# Use ctrl + alt bindings to manage spaces.
# Create, destroy, and focus spaces with the following shortcuts.
# ----------------------------------------------------------------


# Change layout mode of space
ctrl + alt - b : /opt/homebrew/bin/yabai -m space --layout bsp
ctrl + alt - f : /opt/homebrew/bin/yabai -m space --layout float

# Create and delete spaces on the active display
ctrl + alt - c : /opt/homebrew/bin/yabai -m space --create
ctrl + alt - d : /opt/homebrew/bin/yabai -m space --destroy

# Focus specific spaces
alt - 1 : /opt/homebrew/bin/yabai -m space --focus 1
alt - 2 : /opt/homebrew/bin/yabai -m space --focus 2
alt - 3 : /opt/homebrew/bin/yabai -m space --focus 3
alt - 4 : /opt/homebrew/bin/yabai -m space --focus 4
alt - 5 : /opt/homebrew/bin/yabai -m space --focus 5
alt - 6 : /opt/homebrew/bin/yabai -m space --focus 6
alt - 7 : /opt/homebrew/bin/yabai -m space --focus 7
alt - 8 : /opt/homebrew/bin/yabai -m space --focus 8
alt - 9 : /opt/homebrew/bin/yabai -m space --focus 9

# Focus adjacent spaces
ctrl + alt - h : /opt/homebrew/bin/yabai -m space --focus prev
ctrl + alt - l : /opt/homebrew/bin/yabai -m space --focus next

# Focus other display
ctrl + alt - m : /opt/homebrew/bin/yabai -m display --focus recent


# ================================================================
#                           WINDOWS
# ================================================================
# Use alt bindings to manage windows.
# Focus and move windows with these shortcuts.
# ----------------------------------------------------------------


# Focus window
alt - h : /opt/homebrew/bin/yabai -m window --focus west
alt - l : /opt/homebrew/bin/yabai -m window --focus east
alt - k : /opt/homebrew/bin/yabai -m window --focus north
alt - j : /opt/homebrew/bin/yabai -m window --focus south

# Swap windows (in BSP layout)
alt - u : /opt/homebrew/bin/yabai -m window --swap west
alt - i : /opt/homebrew/bin/yabai -m window --swap south
alt - o : /opt/homebrew/bin/yabai -m window --swap north
alt - p : /opt/homebrew/bin/yabai -m window --swap east

# Float/unfloat window and center
alt - f : /opt/homebrew/bin/yabai -m window --toggle float; /opt/homebrew/bin/yabai -m window --grid 4:4:1:1:2:2

# Increase window size while keeping center fixed
alt - x : /opt/homebrew/bin/yabai -m window --resize left:-15:0; /opt/homebrew/bin/yabai -m window --resize right:15:0; /opt/homebrew/bin/yabai -m window --resize top:0:-9; /opt/homebrew/bin/yabai -m window --resize bottom:0:9

# Decrease window size while keeping center fixed
alt - z : /opt/homebrew/bin/yabai -m window --resize left:15:0; /opt/homebrew/bin/yabai -m window --resize right:-15:0; /opt/homebrew/bin/yabai -m window --resize top:0:9; /opt/homebrew/bin/yabai -m window --resize bottom:0:-9

# Resize to preset (small, medium, large) and center window
alt - b : /opt/homebrew/bin/yabai -m window --grid 4:4:1:1:2:2
alt - n : /opt/homebrew/bin/yabai -m window --grid 8:8:1:1:6:6
alt - m : /opt/homebrew/bin/yabai -m window --grid 200:200:1:1:198:198

# cycle all windows on space backwards by coordinate
cmd - tab : /opt/homebrew/bin/yabai -m window --focus "$(/opt/homebrew/bin/yabai -m query --windows --space | jq -re "[sort_by(.id, .frame) | reverse | .[] | select(.role == \"AXWindow\" and .subrole == \"AXStandardWindow\") | .id] | nth(index($(/opt/homebrew/bin/yabai -m query --windows --window | jq -re ".id")) - 1)")"


