# ================================================================
#                           LAYOUT
# ================================================================
# Change your layout
# ----------------------------------------------------------------


# Increase window sizes
alt + shift - h : /opt/homebrew/bin/yabai -m window --resize left:-20:0
alt + shift - j : /opt/homebrew/bin/yabai -m window --resize bottom:0:20
alt + shift - k : /opt/homebrew/bin/yabai -m window --resize top:0:-20
alt + shift - l : /opt/homebrew/bin/yabai -m window --resize right:20:0

# Decrease window sizes
alt + shift - p : /opt/homebrew/bin/yabai -m window --resize left:20:0
alt + shift - i : /opt/homebrew/bin/yabai -m window --resize bottom:0:-20
alt + shift - o : /opt/homebrew/bin/yabai -m window --resize top:0:20
alt + shift - u : /opt/homebrew/bin/yabai -m window --resize right:-20:0

# Mirror window layout
alt - 0x2A : /opt/homebrew/bin/yabai -m space --mirror y-axis
alt - 0x1B : /opt/homebrew/bin/yabai -m space --mirror x-axis

# Balance windows
alt - 0 : /opt/homebrew/bin/yabai -m space --balance

# Rotate tree
alt - r : /opt/homebrew/bin/yabai -m space --rotate 90


# ================================================================
#                           MOVE
# ================================================================
# Move windows between spaces
# ----------------------------------------------------------------


# Move windows between spaces and focus the space
move < alt - p : /opt/homebrew/bin/yabai -m window --space prev; /opt/homebrew/bin/yabai -m space --focus prev
move < alt - n : /opt/homebrew/bin/yabai -m window --space next; /opt/homebrew/bin/yabai -m space --focus next
move < alt - 1 : /opt/homebrew/bin/yabai -m window --space 1; /opt/homebrew/bin/yabai -m space --focus 1
move < alt - 2 : /opt/homebrew/bin/yabai -m window --space 2; /opt/homebrew/bin/yabai -m space --focus 2
move < alt - 3 : /opt/homebrew/bin/yabai -m window --space 3; /opt/homebrew/bin/yabai -m space --focus 3
move < alt - 4 : /opt/homebrew/bin/yabai -m window --space 4; /opt/homebrew/bin/yabai -m space --focus 4
move < alt - 5 : /opt/homebrew/bin/yabai -m window --space 5; /opt/homebrew/bin/yabai -m space --focus 5
move < alt - 6 : /opt/homebrew/bin/yabai -m window --space 6; /opt/homebrew/bin/yabai -m space --focus 6
move < alt - 7 : /opt/homebrew/bin/yabai -m window --space 7; /opt/homebrew/bin/yabai -m space --focus 7
move < alt - 8 : /opt/homebrew/bin/yabai -m window --space 8; /opt/homebrew/bin/yabai -m space --focus 8
move < alt - 9 : /opt/homebrew/bin/yabai -m window --space 9; /opt/homebrew/bin/yabai -m space --focus 9
move < alt - 0 : /opt/homebrew/bin/yabai -m window --space 10; /opt/homebrew/bin/yabai -m space --focus 10


# ================================================================
#                           Float layout
# ================================================================
# Puts floating windows in grid positions.
# ----------------------------------------------------------------


# Top left corner
float < 1 : /opt/homebrew/bin/yabai -m window --grid 200:200:0:0:100:100

# Top right corner
float < 2 : /opt/homebrew/bin/yabai -m window --grid 200:200:100:0:100:100

# Bottom right corner
float < 3 : /opt/homebrew/bin/yabai -m window --grid 200:200:100:100:100:100

# Bottom left corner
float < 4 : /opt/homebrew/bin/yabai -m window --grid 200:200:0:100:100:100

# Left half
float < h : /opt/homebrew/bin/yabai -m window --grid 200:200:0:0:100:200

# Bottom half
float < j : /opt/homebrew/bin/yabai -m window --grid 200:200:0:100:200:100

# Top half
float < k : /opt/homebrew/bin/yabai -m window --grid 200:200:0:0:200:100

# Right half
float < l : /opt/homebrew/bin/yabai -m window --grid 200:200:100:0:100:200
